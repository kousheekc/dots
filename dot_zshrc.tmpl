# ~/.zshrc — managed by chezmoi (github.com/kousheekc/dots). Edit with `chezmoi edit ~/.zshrc`.
# Every tool below is optional: if it isn't installed, its setup is skipped.

has() { command -v "$1" >/dev/null 2>&1; }

# ── oh-my-zsh ──────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
if [ -d "$ZSH" ]; then
  ZSH_THEME=""   # prompt handled by starship
  plugins=(git)
  for p in zsh-syntax-highlighting zsh-autosuggestions; do
    [ -d "${ZSH_CUSTOM:-$ZSH/custom}/plugins/$p" ] && plugins+=("$p")
  done
  source "$ZSH/oh-my-zsh.sh"
fi

# ── PATH ───────────────────────────────────────────────────
typeset -U path   # no duplicate PATH entries
[ -d "$HOME/.local/bin" ] && path=("$HOME/.local/bin" $path)   # chezmoi, uv, claude, herdr, starship…
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"     # uv
[ -d "$HOME/.pixi/bin" ] && export PATH="$HOME/.pixi/bin:$PATH"
{{- if eq .chezmoi.os "darwin" }}

# Homebrew LLVM (macOS)
export LDFLAGS="-L/opt/homebrew/opt/llvm/lib"
export CPPFLAGS="-I/opt/homebrew/opt/llvm/include"
{{- end }}

# ── conda ──────────────────────────────────────────────────
if [ -x "$HOME/miniconda3/bin/conda" ]; then
  __conda_setup="$("$HOME/miniconda3/bin/conda" shell.zsh hook 2>/dev/null)" && eval "$__conda_setup"
  unset __conda_setup
fi

# ── Tools ──────────────────────────────────────────────────
has starship && eval "$(starship init zsh)"
has fzf      && eval "$(fzf --zsh)"
has atuin    && eval "$(atuin init zsh --disable-up-arrow)"   # Ctrl-R; up-arrow left alone

[ -f "$XDG_CONFIG_HOME/zsh/aliases.zsh" ] && source "$XDG_CONFIG_HOME/zsh/aliases.zsh"

# Option+Left/Right move by word (needed inside herdr)
bindkey $'\e[1;3D' backward-word
bindkey $'\e[1;3C' forward-word

# Machine-specific setup (module loads, cluster env vars): not tracked in the repo.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# zoxide replaces cd (`cdi` = interactive picker). Must stay last.
has zoxide && eval "$(zoxide init zsh --cmd cd)"
