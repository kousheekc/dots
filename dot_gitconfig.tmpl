[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = {{ .name }}
	email = {{ .email }}
[http]
	postBuffer = 524288000
[merge]
	conflictStyle = zdiff3
{{- if lookPath "delta" }}
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	line-numbers = true
{{- else }}
# delta not found when this file was generated; install it and run `chezmoi apply` to enable.
{{- end }}
