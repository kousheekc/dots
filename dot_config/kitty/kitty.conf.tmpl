# Mirrors ~/.config/ghostty/config

# Background
background_opacity 0.85
{{- if eq .chezmoi.os "darwin" }}
background_blur 20
{{- end }}

# Cursor trail
cursor_trail 1
cursor_trail_decay 0.1 0.4
cursor_trail_start_threshold 2

# Bell
enable_audio_bell no

# Window
font_size 13.0
window_padding_width 0 5
remember_window_size no
initial_window_width 203c
initial_window_height 69c
{{- if eq .chezmoi.os "darwin" }}
hide_window_decorations titlebar-only
watcher center_window.py
{{- end }}

{{- if eq .chezmoi.os "darwin" }}

# macOS
macos_option_as_alt yes
{{- end }}

# Catppuccin Mocha on crust (near-black), softened text, colors taken from Ghostty's bundled theme
foreground #bac2de
background #11111b
cursor #f5e0dc
cursor_text_color #11111b
selection_foreground #1e1e2e
selection_background #f5e0dc

color0 #45475a
color1 #f38ba8
color2 #a6e3a1
color3 #f9e2af
color4 #89b4fa
color5 #f5c2e7
color6 #94e2d5
color7 #bac2de
color8 #585b70
color9 #f7aec2
color10 #c2ecbf
color11 #fcd682
color12 #aeccfc
color13 #f398da
color14 #b1eae1
color15 #a6adc8

# kitty-only UI, from the upstream Catppuccin Mocha kitty theme (bars darkened to crust)
url_color #f5e0dc
active_border_color #b4befe
inactive_border_color #6c7086
bell_border_color #f9e2af
active_tab_foreground #11111b
active_tab_background #cba6f7
inactive_tab_foreground #bac2de
inactive_tab_background #11111b
tab_bar_background #11111b
